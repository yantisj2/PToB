# Explicit public fixes in generated copies; ordinary native GM/RC and verbose.
# DC/PC return before this include; BSIM keeps its stock controller.
if(CONFIG_ARM AND NOT CONFIG_BOARD_NRF52_BSIM AND NOT R2_DC_PROFILE AND NOT R2_PC_PROFILE)
 set(r2_radio_fix_out "${CMAKE_CURRENT_BINARY_DIR}/r2_radio_fixes")
 execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/controller_radio_fixes.py"
  "${ZEPHYR_BASE}" "${r2_radio_fix_out}" RESULT_VARIABLE r2_radio_fix_result)
 if(NOT r2_radio_fix_result EQUAL 0)
  message(FATAL_ERROR "Pinned controller radio backport generation failed")
 endif()
 get_target_property(r2_fix_sources subsys__bluetooth__controller__ll_sw__nordic SOURCES)
 set(r2_fix_radio_matches 0)
 set(r2_fix_conn_matches 0)
 foreach(r2_source IN LISTS r2_fix_sources)
  foreach(r2_name radio.c lll_conn.c)
   if(r2_source MATCHES "(^|/)(lll|hal/nrf5/radio)/${r2_name}$")
    list(REMOVE_ITEM r2_fix_sources "${r2_source}")
    list(APPEND r2_fix_sources "${r2_radio_fix_out}/${r2_name}")
    if(r2_name STREQUAL "radio.c")
     math(EXPR r2_fix_radio_matches "${r2_fix_radio_matches}+1")
    else()
     math(EXPR r2_fix_conn_matches "${r2_fix_conn_matches}+1")
    endif()
   endif()
  endforeach()
 endforeach()
 if(NOT r2_fix_radio_matches EQUAL 1 OR NOT r2_fix_conn_matches EQUAL 1)
  message(FATAL_ERROR "Expected exactly one original Nordic radio.c and one lll_conn.c")
 endif()
 set_property(TARGET subsys__bluetooth__controller__ll_sw__nordic PROPERTY SOURCES "${r2_fix_sources}")
 target_include_directories(subsys__bluetooth__controller__ll_sw__nordic PRIVATE
  "${ZEPHYR_BASE}/subsys/bluetooth/controller/ll_sw/nordic/hal/nrf5/radio")
endif()
