 /*****************************************************************************
  * Defines
@@ -359,6 +363,30 @@
 #define TICKER_INSTANCE_MAX 1
 static struct ticker_instance _instance[TICKER_INSTANCE_MAX];
 
+/* Caller holds the existing UP IRQ mask. Raw counters/context are a current
+ * scalar cut, not proof of on-air activity, progress or connection generation. */
+void ptob_ticker_snapshot_locked(uint8_t instance_index, uint8_t ticker_id,
+                                const void *context, struct ptob_ticker_snapshot *out)
+{
+    *out = (struct ptob_ticker_snapshot){0};
+    if (instance_index >= TICKER_INSTANCE_MAX) {
+        return;
+    }
+    const struct ticker_instance *instance = &_instance[instance_index];
+    if (!instance->nodes || ticker_id >= instance->count_node) {
+        return;
+    }
+    const struct ticker_node *node = &instance->nodes[ticker_id];
+    out->valid = 1;
+    out->context_matches = node->context == context;
+    out->req = node->req;
+    out->ack = node->ack;
+    out->lazy_current = node->lazy_current;
+    out->ticks_periodic = node->ticks_periodic;
+    out->job_guard = instance->job_guard;
+    out->worker_trigger = instance->worker_trigger;
+}
+
 /*****************************************************************************
  * Static Functions
  ****************************************************************************/
