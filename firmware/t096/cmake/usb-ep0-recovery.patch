+void r2_usb_debug_snapshot(uint32_t out[8])
+{
+ unsigned key = irq_lock();
+ r2_usb_health_snapshot(out);
+ out[4] = NRF_USBD->EVENTCAUSE;
+ out[5] = NRF_USBD->INTEN;
+ out[6] = NRF_CLOCK->HFCLKSTAT;
+ out[7] = NRF_POWER->USBREGSTATUS;
+ irq_unlock(key);
 }
 
