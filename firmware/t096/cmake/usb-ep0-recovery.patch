+/* Read-only observer. Flags0..7 retain attached/ready/VBUS/suspended/
+ * software-enabled/pending/SETUP/RESET;8 DMA held;9 inconsistent PHY;
+ *10 regulator ready;11 peripheral enabled;12 pullup;13 IRQ;24..31 DMA EP.
+ *14 hardware LOWPOWER;15 software bus suspend;22 NVIC pending. Progress is DMA completions
+ * while held, otherwise worker dispatch; FRAMECNTR separately observes SOFs. */
+extern uint32_t r2_usb_dma_health(uint32_t *progress);
+void r2_usb_health_snapshot(uint32_t out[4])
+{
+ unsigned key = irq_lock();
+ struct nrf_usbd_ctx *ctx = get_usbd_ctx();
+ unsigned power = nrfx_power_usbstatus_get();
+ bool enabled = NRF_USBD->ENABLE != 0, pullup = NRF_USBD->USBPULLUP != 0;
+ bool low_power = nrf_usbd_common_suspend_check(), bus_suspend = nrf_usbd_common_bus_suspend_check();
+ bool irq = irq_is_enabled(USBD_IRQn);
+ bool pending = NVIC_GetPendingIRQ(USBD_IRQn) != 0;
+ out[0] = ctx->attached | (ctx->ready << 1) |
+  ((power != NRFX_POWER_USB_STATE_DISCONNECTED) << 2) |
+  ((bus_suspend || low_power) << 3) |
+  (nrf_usbd_common_is_enabled() << 4) | (ctx->health_pending << 5) |
+  (!!NRF_USBD->EVENTS_EP0SETUP << 6) | (!!NRF_USBD->EVENTS_USBRESET << 7) |
+  (((power == NRFX_POWER_USB_STATE_READY && (!ctx->ready || !enabled || (!low_power && !pullup) || !irq)) || (low_power && !bus_suspend)) << 9) |
+  ((power == NRFX_POWER_USB_STATE_READY) << 10) | (enabled << 11) | (pullup << 12) | (irq << 13) | (low_power << 14) | (bus_suspend << 15) | (pending << 22);
+ out[1] = ctx->health_progress;
+ out[0] |= r2_usb_dma_health(&out[1]);
+ out[2] = ctx->ep0_generation;
+ out[3] = NRF_USBD->FRAMECNTR;
+ irq_unlock(key);
+}
