+/* USBPULLUP advertises a live device. Both the PHY regulator and the
+ * asynchronous crystal request must be ready before connecting. This runs
+ * on the dedicated USB worker, with no DMA active and a finite wait. */
+static bool hfxo_ready(struct nrf_usbd_ctx *ctx)
+{
+	int64_t deadline = k_uptime_get() + 20;
+
+	while (nrfx_power_usbstatus_get() == NRFX_POWER_USB_STATE_READY) {
+		int result;
+		int rc = sys_notify_fetch_result(&ctx->hfxo_cli.notify, &result);
+
+		if (!rc) {
+			return result >= 0;
+		}
+		if (rc != -EAGAIN || k_uptime_get() >= deadline) {
+			break;
+		}
+		k_sleep(K_MSEC(1));
+	}
+	return false;
+}
