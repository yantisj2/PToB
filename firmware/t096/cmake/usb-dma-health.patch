+/* Sticky until MCU reset:1 ownership,2 local PHY exit,3 parity DMA,4 READY.
+ * No software timeout establishes DMA retirement or permits buffer reuse. */
+static atomic_t r2_lifecycle_failure;
+static bool r2_wakeup_requested;
+bool r2_usb_common_failed(void) { return atomic_get(&r2_lifecycle_failure) != 0; }
+static void r2_usb_fail(unsigned reason) { (void)atomic_cas(&r2_lifecycle_failure, 0, reason); }
+static bool r2_usb_dma_take(void)
+{
+ if (r2_usb_common_failed()) return false;
+ if (k_sem_take(&dma_available, K_MSEC(20))) { r2_usb_fail(1); return false; }
+ if (!r2_usb_common_failed()) return true;
+ k_sem_give(&dma_available); /* Only this actually acquired token. */
+ return false;
+}
+static bool r2_usb_wait(volatile uint32_t *event, uint32_t mask)
+{
+ int64_t deadline = k_uptime_get() + 20;
+ while (!(*event & mask)) {
+  if (k_uptime_get() >= deadline) return false;
+  k_sleep(K_MSEC(1)); /* IRQs and other owners remain schedulable. */
+ }
+ return !r2_usb_common_failed();
+}
+
+/* Called under the application observer IRQ fence. Never wait or retire DMA.
+ * A held semaphore is outstanding DMA or a blocked lifecycle owner; unlike
+ * waiting for a host IN token, neither may remain held for30 seconds. */
+uint32_t r2_usb_dma_health(uint32_t *progress)
+{
+	uint32_t flags = ((uint32_t)dma_ep << 24) | ((uint32_t)nrf_usbd_common_errata_199() << 16) |
+  ((uint32_t)atomic_get(&r2_lifecycle_failure) << 19) | ((uint32_t)nrf52_errata_162() << 17) | ((uint32_t)nrf_usbd_common_errata_211() << 18);
+	if (!k_sem_count_get(&dma_available)) {
+		*progress = r2_dma_completions;
+		flags |= 1u << 8;
+	}
+	return flags;
+}
 
