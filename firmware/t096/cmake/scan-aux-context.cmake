# Shared normal GM/RC controller correction; upstream checkout remains clean.
if(CONFIG_ARM AND NOT CONFIG_BOARD_NRF52_BSIM AND NOT R2_DC_PROFILE AND NOT R2_PC_PROFILE)
 set(r2_aux_out "${CMAKE_CURRENT_BINARY_DIR}/r2_scan_aux_context")
 execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/scan_aux_context.py"
  "${ZEPHYR_BASE}" "${r2_aux_out}" RESULT_VARIABLE r2_aux_result)
 if(NOT r2_aux_result EQUAL 0)
  message(FATAL_ERROR "Pinned periodic AUX context correction failed")
 endif()
 get_target_property(r2_aux_sources subsys__bluetooth__controller SOURCES)
 set(r2_aux_matches 0)
 foreach(r2_source IN LISTS r2_aux_sources)
  if(r2_source MATCHES "(^|/)ll_sw/ull_scan_aux.c$")
   list(REMOVE_ITEM r2_aux_sources "${r2_source}")
   list(APPEND r2_aux_sources "${r2_aux_out}/ull_scan_aux.c")
   math(EXPR r2_aux_matches "${r2_aux_matches}+1")
  endif()
 endforeach()
 if(NOT r2_aux_matches EQUAL 1)
  message(FATAL_ERROR "Expected exactly one pinned ULL AUX source")
 endif()
 set_property(TARGET subsys__bluetooth__controller PROPERTY SOURCES "${r2_aux_sources}")
 target_include_directories(subsys__bluetooth__controller PRIVATE "${ZEPHYR_BASE}/subsys/bluetooth/controller/ll_sw")
endif()
