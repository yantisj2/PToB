# Fault-only native normal images; verbose mode retains its explicit counters.
# Apply after existing pinned ULL backport; DC/PC remain excluded.
if((CONFIG_ARM AND NOT CONFIG_BOARD_NRF52_BSIM AND NOT R2_PC_PROFILE AND NOT R2_DC_PROFILE) OR R2_CONTROLLER_DIAGNOSTICS)
 set(r2_prepare_mode failure-only)
 if(R2_CONTROLLER_DIAGNOSTICS)
  set(r2_prepare_mode verbose)
 endif()
 set(r2_diag_out "${CMAKE_CURRENT_BINARY_DIR}/r2_controller_diag")
 execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/controller_diag_hooks.py"
  "${r2_controller}/ll_sw/ull.c" "${r2_diag_out}" "${r2_prepare_mode}" RESULT_VARIABLE r2_diag_result)
 if(NOT r2_diag_result EQUAL 0)
  message(FATAL_ERROR "Controller diagnostic hook generation failed")
 endif()
 get_target_property(r2_diag_sources subsys__bluetooth__controller SOURCES)
 set(r2_diag_matches 0)
 foreach(r2_source IN LISTS r2_diag_sources)
  if(r2_source STREQUAL "${r2_controller}/ll_sw/ull.c")
   list(REMOVE_ITEM r2_diag_sources "${r2_source}")
   list(APPEND r2_diag_sources "${r2_diag_out}/ull.c")
   math(EXPR r2_diag_matches "${r2_diag_matches}+1")
  endif()
 endforeach()
 if(NOT r2_diag_matches EQUAL 1)
  message(FATAL_ERROR "Expected exactly one already-patched ULL source")
 endif()
 set_property(TARGET subsys__bluetooth__controller PROPERTY SOURCES "${r2_diag_sources}")
 target_include_directories(subsys__bluetooth__controller PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../include")
 target_compile_definitions(subsys__bluetooth__controller PRIVATE R2_CONTROLLER_FAULT_CAPTURE=1)
 target_compile_definitions(app PRIVATE R2_CONTROLLER_FAULT_CAPTURE=1)
 if(R2_CONTROLLER_DIAGNOSTICS)
  target_compile_definitions(subsys__bluetooth__controller PRIVATE R2_CONTROLLER_DIAGNOSTICS=1)
  target_compile_definitions(app PRIVATE R2_CONTROLLER_DIAGNOSTICS=1)
 endif()
 target_sources(app PRIVATE src/controller_diag.c)
 if(NOT R2_CONTROLLER_DIAGNOSTICS)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/controller_prepare_context.py"
   "${ZEPHYR_BASE}" "${r2_diag_out}" RESULT_VARIABLE r2_context_result)
  if(NOT r2_context_result EQUAL 0)
   message(FATAL_ERROR "Pinned LLL fault-context generation failed")
  endif()
  get_target_property(r2_lll_sources subsys__bluetooth__controller__ll_sw__nordic SOURCES)
  set(r2_lll_matches 0)
  foreach(r2_source IN LISTS r2_lll_sources)
   if(r2_source MATCHES "(^|/)lll/lll.c$")
    list(REMOVE_ITEM r2_lll_sources "${r2_source}")
    list(APPEND r2_lll_sources "${r2_diag_out}/lll.c")
    math(EXPR r2_lll_matches "${r2_lll_matches}+1")
   endif()
  endforeach()
  if(NOT r2_lll_matches EQUAL 1)
   message(FATAL_ERROR "Expected exactly one pinned Nordic LLL core")
  endif()
  set_property(TARGET subsys__bluetooth__controller__ll_sw__nordic PROPERTY SOURCES "${r2_lll_sources}")
  target_compile_definitions(subsys__bluetooth__controller__ll_sw__nordic PRIVATE R2_CONTROLLER_FAULT_CAPTURE=1)
 endif()
endif()
