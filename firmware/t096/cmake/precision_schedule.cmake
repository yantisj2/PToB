# Explicit PToB scheduling policy, separate from the upstream teardown backport.
set(r2_precision_out "${CMAKE_CURRENT_BINARY_DIR}/r2_precision_controller")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/precision_schedule.py"
 "${ZEPHYR_BASE}" "${r2_precision_out}" RESULT_VARIABLE r2_precision_result)
if(NOT r2_precision_result EQUAL 0)
 message(FATAL_ERROR "Pinned precision scheduling generation failed")
endif()
get_target_property(r2_precision_sources subsys__bluetooth__controller SOURCES)
set(r2_precision_matches 0)
foreach(r2_source IN LISTS r2_precision_sources)
 foreach(r2_name ull_adv_sync.c ull_sync.c)
  if(r2_source MATCHES "(^|/)ll_sw/${r2_name}$")
   list(REMOVE_ITEM r2_precision_sources "${r2_source}")
   list(APPEND r2_precision_sources "${r2_precision_out}/${r2_name}")
   math(EXPR r2_precision_matches "${r2_precision_matches}+1")
  endif()
 endforeach()
endforeach()
if(NOT r2_precision_matches EQUAL 2)
 message(FATAL_ERROR "Expected both pinned periodic ULL sources")
endif()
set_property(TARGET subsys__bluetooth__controller PROPERTY SOURCES "${r2_precision_sources}")
target_include_directories(subsys__bluetooth__controller PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../include")
