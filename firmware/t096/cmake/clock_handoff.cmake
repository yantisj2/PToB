# Narrow pinned nrfx correction: a masked inherited HF event is not a driver
# completion. Keep anomaly201, calibration and all clock/controller ownership.
set(r2_clock_original "${NRFX_DIR}/drivers/src/nrfx_clock.c")
file(SHA256 "${r2_clock_original}" r2_clock_sha)
if(NOT r2_clock_sha STREQUAL "174b25053a19925012ccc82fe91a98a0fd99afcd49be9e03c99d612512d678dd")
 message(FATAL_ERROR "Unexpected nrfx clock body; handoff correction requires exact pin")
endif()
file(READ "${r2_clock_original}" r2_clock_body)
set(r2_clock_before "    if (nrf_clock_event_check(NRF_CLOCK, NRF_CLOCK_EVENT_HFCLKSTARTED))")
set(r2_clock_after "    if (nrf_clock_event_check(NRF_CLOCK, NRF_CLOCK_EVENT_HFCLKSTARTED) &&\n        nrf_clock_int_enable_check(NRF_CLOCK, NRF_CLOCK_INT_HF_STARTED_MASK))")
string(REPLACE "${r2_clock_before}" "${r2_clock_after}" r2_clock_fixed "${r2_clock_body}")
if(r2_clock_fixed STREQUAL r2_clock_body)
 message(FATAL_ERROR "Clock correction did not apply")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/r2_nrfx_clock.c" "${r2_clock_fixed}")
get_target_property(r2_nrfx_sources modules__hal_nordic__nrfx SOURCES)
set(r2_clock_matches 0)
foreach(r2_source IN LISTS r2_nrfx_sources)
 if(r2_source STREQUAL r2_clock_original)
  math(EXPR r2_clock_matches "${r2_clock_matches}+1")
 endif()
endforeach()
if(NOT r2_clock_matches EQUAL 1)
 message(FATAL_ERROR "Expected exactly one pinned nrfx clock translation unit")
endif()
list(REMOVE_ITEM r2_nrfx_sources "${r2_clock_original}")
set_property(TARGET modules__hal_nordic__nrfx PROPERTY SOURCES "${r2_nrfx_sources}")
target_sources(modules__hal_nordic__nrfx PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/r2_nrfx_clock.c")
