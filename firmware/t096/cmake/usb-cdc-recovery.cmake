# Selected normal GM/RC USB correction; pinned SDK sources remain untouched.
if(CONFIG_USB_DEVICE_STACK AND NOT R2_DC_PROFILE AND NOT R2_PC_PROFILE)
 set(r2_usb_out "${CMAKE_CURRENT_BINARY_DIR}/r2_usb_cdc_recovery")
 execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/usb_cdc_recovery.py"
  "${ZEPHYR_BASE}" "${r2_usb_out}" RESULT_VARIABLE r2_usb_result)
 if(NOT r2_usb_result EQUAL 0)
  message(FATAL_ERROR "Pinned USB CDC recovery generation failed")
 endif()
 if(NOT TARGET zephyr)
  message(FATAL_ERROR "Pinned Zephyr aggregate source target is missing")
 endif()
 get_target_property(r2_usb_sources zephyr SOURCES)
 foreach(r2_usb_leaf usb_transfer.c cdc_acm.c)
  set(r2_usb_matches 0)
  foreach(r2_usb_source IN LISTS r2_usb_sources)
   if(r2_usb_source MATCHES "(^|/)${r2_usb_leaf}$")
    list(REMOVE_ITEM r2_usb_sources "${r2_usb_source}")
    list(APPEND r2_usb_sources "${r2_usb_out}/${r2_usb_leaf}")
    math(EXPR r2_usb_matches "${r2_usb_matches}+1")
   endif()
  endforeach()
  if(NOT r2_usb_matches EQUAL 1)
   message(FATAL_ERROR "Expected exactly one selected USB source: ${r2_usb_leaf}")
  endif()
 endforeach()
 set_property(TARGET zephyr PROPERTY SOURCES "${r2_usb_sources}")
 target_include_directories(zephyr PRIVATE "${ZEPHYR_BASE}/subsys/usb/device" "${ZEPHYR_BASE}/subsys/usb/device/class")
 target_compile_definitions(app PRIVATE R2_USB_CDC_RECOVERY=1)
endif()
