# Standard RC7 USB recovery patch. Leave the pinned dependency checkout intact.
if((R2_RC_PROFILE OR R2_DC_PROFILE) AND R2_USB_SOURCE_STREAM)
 set(r2_usb_fixed "${CMAKE_CURRENT_BINARY_DIR}/r2_usb_dc_nrfx.c")
 execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/usb_ep0_recovery.py"
  "${ZEPHYR_BASE}" "${r2_usb_fixed}" RESULT_VARIABLE r2_usb_result)
 if(NOT r2_usb_result EQUAL 0)
  message(FATAL_ERROR "Pinned Nordic EP0 recovery materialization failed")
 endif()
 get_target_property(r2_usb_sources drivers__usb__device SOURCES)
 set(r2_usb_matches 0)
 foreach(r2_source IN LISTS r2_usb_sources)
  if(r2_source STREQUAL "usb_dc_nrfx.c" OR r2_source STREQUAL "${ZEPHYR_BASE}/drivers/usb/device/usb_dc_nrfx.c")
   list(REMOVE_ITEM r2_usb_sources "${r2_source}")
   list(APPEND r2_usb_sources "${r2_usb_fixed}")
   math(EXPR r2_usb_matches "${r2_usb_matches}+1")
  endif()
 endforeach()
 if(NOT r2_usb_matches EQUAL 1)
  message(FATAL_ERROR "Expected exactly one pinned Nordic USB driver")
 endif()
 set_property(TARGET drivers__usb__device PROPERTY SOURCES "${r2_usb_sources}")
 set(r2_dma_fixed "${CMAKE_CURRENT_BINARY_DIR}/r2_nrf_usbd_common.c")
 execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/usb_ep0_recovery.py"
  "${ZEPHYR_BASE}" "${r2_dma_fixed}" usb-dma-health RESULT_VARIABLE r2_dma_result)
 if(NOT r2_dma_result EQUAL 0)
  message(FATAL_ERROR "Pinned Nordic DMA observer materialization failed")
 endif()
 get_target_property(r2_dma_sources drivers__usb__common__nrf_usbd_common SOURCES)
 set(r2_dma_matches 0)
 foreach(r2_source IN LISTS r2_dma_sources)
  if(r2_source STREQUAL "nrf_usbd_common.c" OR r2_source STREQUAL "${ZEPHYR_BASE}/drivers/usb/common/nrf_usbd_common/nrf_usbd_common.c")
   list(REMOVE_ITEM r2_dma_sources "${r2_source}")
   list(APPEND r2_dma_sources "${r2_dma_fixed}")
   math(EXPR r2_dma_matches "${r2_dma_matches}+1")
  endif()
 endforeach()
 if(NOT r2_dma_matches EQUAL 1)
  message(FATAL_ERROR "Expected exactly one pinned Nordic common driver")
 endif()
 set_property(TARGET drivers__usb__common__nrf_usbd_common PROPERTY SOURCES "${r2_dma_sources}")
 if(R2_USB_AWAKE_CONTROL)
  target_compile_definitions(drivers__usb__common__nrf_usbd_common PRIVATE R2_USB_AWAKE_CONTROL=1)
 endif()
endif()
