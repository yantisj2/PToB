# GM7 native owner; apply after the existing pinned controller generators.
if(R2_GM7_NATIVE AND CONFIG_ARM AND NOT CONFIG_BOARD_NRF52_BSIM)
 if(R2_DC_PROFILE OR R2_PC_PROFILE)
  message(FATAL_ERROR "GM7 is normal GM work only")
 endif()
 # Coarse wire sizes occur in shared jobs; app and both controller targets must agree.
 target_compile_definitions(app PRIVATE R2_GM7_NATIVE=1 R2_TZ_WIRE=1)
 foreach(pair R2_TZ_MODE R2_TZ_MANUAL_ID R2_TZ_MANUAL_MIN)
  if(NOT DEFINED ${pair})
   message(FATAL_ERROR "Use the builder for explicit TZ configuration")
  endif()
 endforeach()
 target_compile_definitions(app PRIVATE R2_TZ_AUTO=1
  R2_TZ_MODE=${R2_TZ_MODE} R2_TZ_MANUAL_ID=${R2_TZ_MANUAL_ID} R2_TZ_MANUAL_MIN=${R2_TZ_MANUAL_MIN})
 target_sources(app PRIVATE src/time_zone_database.c src/time_zone_selector.c)
 target_sources(app PRIVATE protocol/gm7_codec.c protocol/gm7_control.c protocol/gm7_owner.c
  protocol/gm7_schedule.c protocol/gm7_air.c protocol/gm7_bridge.c protocol/gm7_promote.c src/gm7_source.c src/gm7_clock.c src/gm7_capture.c)
 target_compile_definitions(subsys__bluetooth__controller PRIVATE R2_GM7_NATIVE=1 R2_TZ_WIRE=1)
 target_compile_definitions(subsys__bluetooth__controller__ll_sw__nordic PRIVATE R2_GM7_NATIVE=1 R2_TZ_WIRE=1)
 target_sources(subsys__bluetooth__controller__ll_sw__nordic PRIVATE ${CMAKE_CURRENT_LIST_DIR}/../src/gm7_controller.c)
 set_source_files_properties(${CMAKE_CURRENT_LIST_DIR}/../src/gm7_controller.c TARGET_DIRECTORY subsys__bluetooth__controller__ll_sw__nordic PROPERTIES COMPILE_OPTIONS "-Wall;-Wextra;-Werror;-Wno-unused-parameter")
 target_include_directories(subsys__bluetooth__controller__ll_sw__nordic PRIVATE
  ${CMAKE_CURRENT_LIST_DIR}/../include ${CMAKE_CURRENT_LIST_DIR}/../protocol
  ${ZEPHYR_BASE}/subsys/bluetooth/controller/ll_sw)
 get_target_property(gm7_ull_sources subsys__bluetooth__controller SOURCES)
 get_target_property(gm7_lll_sources subsys__bluetooth__controller__ll_sw__nordic SOURCES)
 unset(gm7_ull)
 foreach(p IN LISTS gm7_ull_sources)
  if(p MATCHES "(^|/)hci_driver.c$")
   set(gm7_hci ${p})
  endif()
  if(p MATCHES "(^|/)ull_adv_sync.c$")
   set(gm7_sync ${p})
  endif()
  if(p MATCHES "(^|/)ull.c$")
   if(DEFINED gm7_ull)
    message(FATAL_ERROR "Multiple ULL owners")
   endif()
   set(gm7_ull ${p})
  endif()
 endforeach()
 foreach(p IN LISTS gm7_lll_sources)
  if(p MATCHES "(^|/)lll_scan.c$")
   set(gm7_scan ${p})
  elseif(p MATCHES "(^|/)lll_scan_aux.c$")
   set(gm7_aux ${p})
  endif()
 endforeach()
 if(NOT DEFINED gm7_ull OR NOT DEFINED gm7_scan OR NOT DEFINED gm7_aux OR NOT DEFINED gm7_hci)
  message(FATAL_ERROR "GM7 requires pinned ULL and both passive scanner paths")
 endif()
 set(gm7_out ${CMAKE_CURRENT_BINARY_DIR}/gm7_controller)
 execute_process(COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_LIST_DIR}/../tools/gm7_controller_hooks.py
  ${gm7_ull} ${gm7_scan} ${gm7_aux} ${gm7_sync} ${gm7_out} ${ZEPHYR_BASE}/subsys/bluetooth/controller/hci/hci_driver.c RESULT_VARIABLE gm7_result)
 if(NOT gm7_result EQUAL 0)
  message(FATAL_ERROR "GM7 controller materialization failed")
 endif()
 list(REMOVE_ITEM gm7_ull_sources ${gm7_ull} ${gm7_sync} ${gm7_hci})
 list(APPEND gm7_ull_sources ${gm7_out}/ull.c ${gm7_out}/ull_adv_sync.c ${gm7_out}/hci_driver.c)
 list(REMOVE_ITEM gm7_lll_sources ${gm7_scan} ${gm7_aux})
 list(APPEND gm7_lll_sources ${gm7_out}/lll_scan.c ${gm7_out}/lll_scan_aux.c)
 set_property(TARGET subsys__bluetooth__controller PROPERTY SOURCES "${gm7_ull_sources}")
 set_property(TARGET subsys__bluetooth__controller__ll_sw__nordic PROPERTY SOURCES "${gm7_lll_sources}")
endif()
