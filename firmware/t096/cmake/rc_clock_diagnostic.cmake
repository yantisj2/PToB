set(rc_clock_out "${CMAKE_CURRENT_BINARY_DIR}/rc_clock_diagnostic")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/rc_clock_diagnostic.py" "${ZEPHYR_BASE}" "${rc_clock_out}" "${r2_controller}" "${r2_radio_out}" RESULT_VARIABLE rc_clock_result)
if(NOT rc_clock_result EQUAL 0)
 message(FATAL_ERROR "Pinned LF release diagnostic failed")
endif()
get_target_property(rc_clock_sources subsys__bluetooth__controller__ll_sw__nordic SOURCES)
set(rc_clock_matches 0)
foreach(rc_source IN LISTS rc_clock_sources)
 if(rc_source MATCHES "(^|/)lll/lll_clock.c$")
  list(REMOVE_ITEM rc_clock_sources "${rc_source}")
  list(APPEND rc_clock_sources "${rc_clock_out}/lll_clock.c")
  math(EXPR rc_clock_matches "${rc_clock_matches}+1")
 endif()
endforeach()
if(NOT rc_clock_matches EQUAL 1)
 message(FATAL_ERROR "Expected exactly one LLL clock source")
endif()
set_property(TARGET subsys__bluetooth__controller__ll_sw__nordic PROPERTY SOURCES "${rc_clock_sources}")

get_target_property(rc_ticker_sources subsys__bluetooth__controller SOURCES)
list(REMOVE_ITEM rc_ticker_sources "${r2_controller}/ticker/ticker.c")
list(APPEND rc_ticker_sources "${rc_clock_out}/ticker.c")
set_property(TARGET subsys__bluetooth__controller PROPERTY SOURCES "${rc_ticker_sources}")

target_include_directories(subsys__bluetooth__controller PRIVATE "${ZEPHYR_BASE}/subsys/bluetooth/controller/ticker")
get_target_property(rc_sync_sources subsys__bluetooth__controller__ll_sw__nordic SOURCES)
set(rc_sync_matches 0)
foreach(rc_source IN LISTS rc_sync_sources)
 if(rc_source MATCHES "(^|/)r2_radio_controller/lll_sync.c$")
  list(REMOVE_ITEM rc_sync_sources "${rc_source}")
  list(APPEND rc_sync_sources "${rc_clock_out}/lll_sync.c")
  math(EXPR rc_sync_matches "${rc_sync_matches}+1")
 endif()
endforeach()
if(NOT rc_sync_matches EQUAL 1)
 message(FATAL_ERROR "Expected exactly one LLL sync source")
endif()
set_property(TARGET subsys__bluetooth__controller__ll_sw__nordic PROPERTY SOURCES "${rc_sync_sources}")
