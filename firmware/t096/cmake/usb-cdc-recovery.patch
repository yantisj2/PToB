+/* Bounded readiness check. Existing active transfers retain sole ownership;
+ * no cancel, endpoint reset, or buffer reuse is performed here. */
+static void cdc_acm_rearm_idle(struct cdc_acm_dev_data_t *dev_data)
+{
+	if (!dev_data->configured || dev_data->suspended) {
+		return;
+	}
+	struct usb_cfg_data *cfg = (void *)dev_data->common.dev->config;
+	uint8_t rx = cfg->endpoint[ACM_OUT_EP_IDX].ep_addr;
+	uint8_t tx = cfg->endpoint[ACM_IN_EP_IDX].ep_addr;
+	if (dev_data->rx_irq_ena && !dev_data->rx_paused &&
+	    ring_buf_space_get(dev_data->rx_ringbuf) >= sizeof(dev_data->rx_buf) &&
+	    !usb_transfer_is_busy(rx)) {
+		cdc_acm_read_cb(rx, 0, dev_data);
+	}
+	if (dev_data->tx_irq_ena && !usb_transfer_is_busy(tx)) {
