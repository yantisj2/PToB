/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
  model = "Heltec T096 HT-n5262G app-only V12 R2 stage1";
  compatible = "heltec,t096-v12";
  chosen {
    zephyr,sram = &app_sram;
    zephyr,flash = &flash0;
    zephyr,code-partition = &code_partition;
    zephyr,console = &cdc_acm_uart0;

  };
  app_sram: memory@20002000 {
    compatible = "mmio-sram"; device_type = "memory";
    reg = <0x20002000 0x3e000>;
  };
  app_pins {
    compatible = "gpio-leds";
    gnss_enable: gnss_enable { gpios = <&gpio0 6 GPIO_ACTIVE_LOW>; };
    vext_enable: vext_enable { gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>; };
    tft_backlight: tft_backlight { gpios = <&gpio1 12 GPIO_ACTIVE_LOW>; };
    tft_cs: tft_cs { gpios = <&gpio0 22 GPIO_ACTIVE_LOW>; };
    tft_dc: tft_dc { gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>; };
    tft_reset: tft_reset { gpios = <&gpio0 13 GPIO_ACTIVE_LOW>; };
    tft_button: tft_button { gpios = <&gpio1 10 GPIO_ACTIVE_LOW>; };
    lora_cs: lora_cs { gpios = <&gpio0 5 GPIO_ACTIVE_LOW>; };
    lora_reset: lora_reset { gpios = <&gpio0 16 GPIO_ACTIVE_LOW>; };
    lora_csd: lora_csd { gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>; };
    lora_ctx: lora_ctx { gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>; };
    lora_fem_power: lora_fem_power { gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>; };
    lora_busy: lora_busy { gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>; };
    lora_dio1: lora_dio1 { gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>; };
  };
  backlight_pwm {
    compatible = "pwm-leds";
    ui_backlight: ui_backlight { pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_INVERTED>; };
  };
  pps_pin {
    compatible = "gpio-keys";
    pps: pps { gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>; };
  };
};

/* Match the existing raw application layout, including low8KiB MBR RAM.
 * No stock DK GPIO/flash layout, UICR patch, or sibling board is inherited. */
&sram0 { status = "disabled"; };
&flash0 {
  partitions {
    compatible = "fixed-partitions";
    #address-cells = <1>; #size-cells = <1>;
    resident_partition: partition@0 {
      label = "resident_mbr_s140"; read-only; reg = <0x0 0x26000>;
    };
    code_partition: partition@26000 {
      label = "v12_application"; reg = <0x26000 0xbf000>;
    };
    journal_partition: partition@e5000 {
      label = "existing_cache_journal"; read-only; reg = <0xe5000 0x8000>;
    };
    protected_partition: partition@ed000 {
      label = "protected_recovery_boot"; read-only; reg = <0xed000 0x13000>;
    };
  };
};
&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&gpiote { status = "okay"; };
&pinctrl {
  display_spi_default: display_spi_default {
    group1 { psels = <NRF_PSEL(SPIM_SCK, 0, 20)>, <NRF_PSEL(SPIM_MOSI, 0, 17)>; };
  };
  display_spi_sleep: display_spi_sleep {
    group1 { psels = <NRF_PSEL(SPIM_SCK, 0, 20)>, <NRF_PSEL(SPIM_MOSI, 0, 17)>; low-power-enable; };
  };
  display_pwm_default: display_pwm_default {
    group1 { psels = <NRF_PSEL(PWM_OUT0, 1, 12)>; nordic,invert; };
  };
  display_pwm_sleep: display_pwm_sleep {
    group1 { psels = <NRF_PSEL(PWM_OUT0, 1, 12)>; low-power-enable; };
  };
  gnss_uart_default: gnss_uart_default {
    group1 { psels = <NRF_PSEL(UART_TX, 0, 25)>, <NRF_PSEL(UART_RX, 0, 23)>; };
  };
  gnss_uart_sleep: gnss_uart_sleep {
    group1 {
      psels = <NRF_PSEL(UART_TX, 0, 25)>, <NRF_PSEL(UART_RX, 0, 23)>;
      low-power-enable;
    };
  };
  lora_spi_default: lora_spi_default {
    group1 {
      psels = <NRF_PSEL(SPIM_SCK, 1, 8)>, <NRF_PSEL(SPIM_MOSI, 0, 11)>,
              <NRF_PSEL(SPIM_MISO, 0, 14)>;
    };
  };
  lora_spi_sleep: lora_spi_sleep {
    group1 {
      psels = <NRF_PSEL(SPIM_SCK, 1, 8)>, <NRF_PSEL(SPIM_MOSI, 0, 11)>,
              <NRF_PSEL(SPIM_MISO, 0, 14)>;
      low-power-enable;
    };
  };
};
&spi0 {
  /* SPIM0 IRQ3 at priority6: below BLE controller work. */
  interrupts = <3 6>;
  compatible = "nordic,nrf-spim"; status = "okay";
  pinctrl-0 = <&display_spi_default>; pinctrl-1 = <&display_spi_sleep>;
  pinctrl-names = "default", "sleep";
};
&pwm0 {
  status = "okay";
  interrupts = <28 6>;
  pinctrl-0 = <&display_pwm_default>; pinctrl-1 = <&display_pwm_sleep>;
  pinctrl-names = "default", "sleep";
};
/* Driver-owned SPIM1/DMA/IRQ. There is no SPI transaction or radio command
 * at boot; the unqualified SX1262 stays reset with its FEM disabled. */
&spi1 {
  compatible = "nordic,nrf-spim";
  status = "disabled";
  pinctrl-0 = <&lora_spi_default>; pinctrl-1 = <&lora_spi_sleep>;
  pinctrl-names = "default", "sleep";
};
&uart0 {
  compatible = "nordic,nrf-uarte";
  status = "okay"; current-speed = <115200>;
  /* UC6580 must be powered before the public driver starts EasyDMA RX. */
  zephyr,deferred-init;
  pinctrl-0 = <&gnss_uart_default>; pinctrl-1 = <&gnss_uart_sleep>;
  pinctrl-names = "default", "sleep";
};
zephyr_udc0: &usbd {
  compatible = "nordic,nrf-usbd"; status = "okay";
  cdc_acm_uart0: cdc_acm_uart0 { compatible = "zephyr,cdc-acm-uart"; };
};
/* TIMER3 is reserved for a later controller-safe PPS/capture adapter. No
 * TIMER3/PPI/RADIO capture route is installed by this transport milestone. */
&timer3 { status = "disabled"; };
/* Application nrfx TIMER4 only: LoRa FEM cutoff, never timing capture. */
&timer4 { status = "disabled"; };

/* Public retained-memory owner for resident bootloader request only. */
&gpregret1 { status = "okay"; };
&gpregret2 { status = "disabled"; };
